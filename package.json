{
  "name": "btx24bookingsystems",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev -w @btx24/api\" \"npm run dev -w @btx24/web\"",
    "build": "npm run build -w @btx24/shared && npm run build -w @btx24/api && npm run build -w @btx24/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build -w @btx24/shared && npm run prisma:generate && npm run typecheck && npm run lint && npm run test && npm run build",
    "prisma:generate": "npm run prisma:generate -w @btx24/api",
    "prisma:migrate": "npm run prisma:migrate -w @btx24/api",
    "db:up": "docker compose up -d db",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "mcp": "node tools/mcp-server/src/server.mjs",
    "mcp:cli": "node tools/mcp-server/src/cli.mjs",
    "mcp:test": "npm run test -w @btx24/mcp-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
