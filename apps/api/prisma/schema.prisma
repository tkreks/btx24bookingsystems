// Единственный файл схемы БД (MariaDB/MySQL). Модели добавляются по доменам, каждый домен —
// отдельным блоком с комментарием `// ---------- <Домен> ----------`.
// Правила изменения схемы: AGENTS.md → «База данных и миграции», skill add-prisma-migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Bitrix24: порталы и входящие события ----------

/// Установка приложения на портал Битрикс24 (тенант). Токены — только в зашифрованном виде.
model Portal {
  id                   String       @id @default(cuid())
  /// Неизменный идентификатор портала (не зависит от смены домена).
  memberId             String       @unique @db.VarChar(64)
  domain               String       @db.VarChar(255)
  /// База REST портала, например https://portal.bitrix24.ru/rest/ (из ответа сервера авторизации).
  clientEndpoint       String       @db.VarChar(255)
  /// REST сервера авторизации (облако — https://oauth.bitrix.info/rest/, «коробка» — сам портал).
  serverEndpoint       String       @db.VarChar(255)
  /// sha256(application_token) — проверка подлинности входящих событий.
  applicationTokenHash String?      @db.Char(64)
  accessTokenEnc       String?      @db.Text
  refreshTokenEnc      String?      @db.Text
  accessExpiresAt      DateTime?    @db.DateTime(3)
  scope                String       @default("") @db.VarChar(1000)
  /// Часовой пояс портала для расчёта периодов и отображения.
  timezone             String       @default("Europe/Moscow") @db.VarChar(64)
  status               PortalStatus @default(ACTIVE)
  installedByUserId    Int?
  installedAt          DateTime     @default(now()) @db.DateTime(3)
  uninstalledAt        DateTime?    @db.DateTime(3)
  createdAt            DateTime     @default(now()) @db.DateTime(3)
  updatedAt            DateTime     @updatedAt @db.DateTime(3)
  events               Bitrix24Event[]
  groups               WorkGroup[]
  admins               AppAdmin[]
  settings             PortalSettings?
  externalUsers        ExternalUser[]
  sandboxBookings      SandboxBooking[]
  messageTemplates     MessageTemplate[]
  storedFiles          StoredFile[]
  openlineChats        OpenlineChat[]
  bookingRecords       BookingRecord[]
  resources            Resource[]
  bookingAlerts        BookingAlert[]
}

enum PortalStatus {
  ACTIVE
  UNINSTALLED
}

/// Входящее событие Битрикс24: сначала сохраняем, потом обрабатываем (повторная доставка возможна).
model Bitrix24Event {
  id          String      @id @default(cuid())
  portalId    String
  portal      Portal      @relation(fields: [portalId], references: [id], onDelete: Cascade)
  event       String      @db.VarChar(100)
  payload     Json
  status      EventStatus @default(PENDING)
  error       String?     @db.Text
  receivedAt  DateTime    @default(now()) @db.DateTime(3)
  processedAt DateTime?   @db.DateTime(3)

  @@index([status, receivedAt])
  @@index([portalId, event])
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------- Группы, роли, настройки приложения (ADR 0005) ----------

enum MemberKind {
  USER
  DEPARTMENT
}

enum GroupRole {
  VIEWER
  TECHNOLOGIST
  MANAGER
  GROUP_ADMIN
}

enum BookingMode {
  duration
  interval
}

/// Рабочее направление портала: воронка + ресурсы + настройки + люди с ролями.
model WorkGroup {
  id                String              @id @default(cuid())
  portalId          String
  portal            Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(100)
  sort              Int                 @default(0)
  /// Воронка сделок направления (CATEGORY_ID); null — без привязки.
  dealCategoryId    Int?
  bookingMode       BookingMode         @default(duration)
  durationMinutes   Int                 @default(60)
  checkInTime       String              @default("14:00") @db.Char(5)
  checkOutTime      String              @default("12:00") @db.Char(5)
  defaultNights     Int                 @default(1)
  techWindowMinutes Int                 @default(0)
  /// Включённые функции группы (GROUP_FEATURES из @btx24/shared).
  features          Json
  /// Настройки направления без отдельных колонок (оплаты, поля сделки, каталог, товары по
  /// умолчанию, виды) — схема `groupOptionsSchema`; переносятся из прототипа без потерь.
  options           Json?
  /// id группы в прототипе Node-RED — повторный импорт обновляет, а не дублирует.
  legacyId          String?             @db.VarChar(64)
  archivedAt        DateTime?           @db.DateTime(3)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  resources         WorkGroupResource[]
  members           WorkGroupMember[]
  externalUsers     ExternalUserGroup[]

  @@index([portalId, archivedAt])
  @@unique([portalId, legacyId])
}

/// Ресурс модуля бронирования Битрикс24 в группе. Один ресурс может входить в несколько групп.
model WorkGroupResource {
  groupId    String
  group      WorkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resourceId Int

  @@id([groupId, resourceId])
}

/// Участник группы: сотрудник или отдел Битрикс24 (с вложенными отделами).
model WorkGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  group    WorkGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int
  role     GroupRole

  @@unique([groupId, kind, bitrixId])
}

/// Администраторы приложения (помимо администраторов портала, которые имеют доступ всегда).
model AppAdmin {
  id       String     @id @default(cuid())
  portalId String
  portal   Portal     @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int

  @@unique([portalId, kind, bitrixId])
}

/// Настройки приложения на портале. Сбор данных диалогов — по умолчанию выключен.
model PortalSettings {
  portalId              String   @id
  portal                Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  dialogMetadataEnabled Boolean  @default(false)
  dialogTextsEnabled    Boolean  @default(false)
  /// Перед запуском оплаты удалять у контакта e-mail с «wazzup» (платёжный сервис отклоняет).
  removeWazzupEmail     Boolean  @default(false)
  /// Чат Битрикс24 для уведомлений о бронях (новая бронь мимо приложения, расхождения).
  alertChatId           Int?
  /// Сверка броней с Битрикс24: на сколько дней вперёд от сегодня.
  syncHorizonDays       Int      @default(180)
  /// Первая полная сверка прошла: существующие брони приняты без уведомлений.
  bookingSyncBaselineAt DateTime? @db.DateTime(3)
  /// Последняя сверка броней и её ошибка (для экрана настроек).
  bookingSyncAt         DateTime? @db.DateTime(3)
  bookingSyncError      String?   @db.VarChar(500)
  updatedByUserId       Int?
  updatedAt             DateTime @updatedAt @db.DateTime(3)
}

enum ExternalRole {
  VIEWER
  TECHNOLOGIST
}

/// Пользователь прямой ссылки (вне Битрикс24): только просмотр. Пароль — только хеш (scrypt).
model ExternalUser {
  id           String              @id @default(cuid())
  portalId     String
  portal       Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  login        String              @db.VarChar(100)
  passwordHash String              @db.VarChar(255)
  role         ExternalRole
  /// true — доступ ко всем группам портала (как в прототипе при пустом списке групп).
  allGroups    Boolean             @default(false)
  /// null — видны все поля сделки; иначе список кодов полей.
  visibleFields Json?
  disabledAt   DateTime?           @db.DateTime(3)
  createdAt    DateTime            @default(now()) @db.DateTime(3)
  updatedAt    DateTime            @updatedAt @db.DateTime(3)
  groups       ExternalUserGroup[]

  @@unique([portalId, login])
}

model ExternalUserGroup {
  externalUserId String
  externalUser   ExternalUser @relation(fields: [externalUserId], references: [id], onDelete: Cascade)
  groupId        String
  group          WorkGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([externalUserId, groupId])
}

/// Брони, созданные в песочнице записи (B24_SANDBOX_*): только их можно менять/удалять, и
/// только их удаляет уборка. Реальные брони песочнице недоступны.
model SandboxBooking {
  id        String    @id @default(cuid())
  portalId  String
  portal    Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  bookingId Int
  createdAt DateTime  @default(now()) @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  @@unique([portalId, bookingId])
}

// ---------- Открытые линии ----------

/// Личный шаблон сообщений менеджера: цепочка шагов (текст + вложения), отправляется по порядку.
/// Видит и меняет только автор (`ownerUserId` — ID сотрудника Битрикс24).
model MessageTemplate {
  id          String   @id @default(cuid())
  portalId    String
  portal      Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ownerUserId Int
  name        String   @db.VarChar(100)
  /// `[{ text, fileIds }]` в порядке отправки (`TemplateStepDto` в @btx24/shared).
  steps       Json
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([portalId, ownerUserId])
}

/// Файл вложения для отправки в чат (из шаблона или разовый). Хранится в БД, до 10 МБ: отдаётся
/// в Битрикс24 через im.v2.File.upload. Доступен только автору.
model StoredFile {
  id          String   @id @default(cuid())
  portalId    String
  portal      Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ownerUserId Int
  name        String   @db.VarChar(255)
  mime        String   @db.VarChar(150)
  size        Int
  data        Bytes    @db.LongBlob
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([portalId, ownerUserId])
}

/// Индекс диалогов открытых линий для сортировки «по дате последнего сообщения» — как в списке
/// диалогов Битрикс24. Только метаданные: ни текстов, ни имён. Ведёт worker, пока включён «сбор
/// метаданных диалогов» (`PortalSettings.dialogMetadataEnabled`). Видимость каждому пользователю
/// проверяется его токеном при показе — индекс прав не даёт.
model OpenlineChat {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  chatId        Int
  /// Последняя сессия чата (ID в списке диалогов Битрикс24).
  sessionId     Int
  responsibleId Int?
  completed     Boolean
  connector     String    @db.VarChar(64)
  /// Последнее сообщение клиента или оператора (без системных и ботов).
  lastMessageAt DateTime? @db.DateTime(3)
  lastAuthor    String?   @db.VarChar(10)
  checkedAt     DateTime  @db.DateTime(3)

  @@unique([portalId, chatId])
  @@index([portalId, lastMessageAt])
  @@index([portalId, responsibleId, lastMessageAt])
}

// ---------- Журнал броней ----------

enum BookingKind {
  /// Клиентская бронь, привязана к сделке.
  client
  /// Служебная блокировка ресурса, без сделки.
  service
}

enum BookingStatus {
  active
  cancelled
}

enum BookingCancelReason {
  /// Оплата не поступила за `paymentTimeoutMinutes` (снимает worker).
  payment_timeout
  /// Отменил сотрудник.
  manual
  /// Брони больше нет в Битрикс24 (удалили в портале), решение принято по уведомлению.
  removed_in_bitrix
}

/// Откуда бронь: создана приложением или найдена в Битрикс24 (онлайн-запись, вручную в портале).
enum BookingSource {
  app
  bitrix
}

/// Кто выполнил действие с бронью.
enum BookingActorKind {
  /// Сотрудник Битрикс24 (через приложение).
  user
  /// Автоматизация приложения (worker): неоплата, сверка.
  system
  /// Изменение в самом Битрикс24 — автор неизвестен (события не сообщают, кто).
  bitrix
}

/// Запись приложения о брони, созданной через него (ADR 0006): то, чего у брони в Битрикс24 нет —
/// тип, статус, автор, причина отмены. Время и ресурсы — снимок на момент создания (после отмены
/// брони в Битрикс24 уже нет); истина о слотах — модуль бронирования Битрикс24 (ADR 0003).
model BookingRecord {
  id                String               @id @default(cuid())
  portalId          String
  portal            Portal               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// ID брони в Битрикс24 (`booking.v1.booking`).
  bookingId         Int
  source            BookingSource        @default(app)
  /// Название брони в Битрикс24 (снимок).
  title             String?              @db.VarChar(255)
  kind              BookingKind
  dealId            Int?
  groupId           String?              @db.VarChar(191)
  /// ID ресурсов Битрикс24 (снимок).
  resourceIds       Json
  startsAt          DateTime             @db.DateTime(3)
  endsAt            DateTime             @db.DateTime(3)
  status            BookingStatus        @default(active)
  cancelReason      BookingCancelReason?
  /// Сотрудник Битрикс24, создавший бронь; null — бронь найдена в Битрикс24 (автор неизвестен).
  createdByUserId   Int?
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  cancelledAt       DateTime?            @db.DateTime(3)
  /// null — отменила система (неоплата).
  cancelledByUserId Int?
  /// Последняя сверка, на которой бронь была в Битрикс24 в ожидаемом виде.
  syncedAt          DateTime?            @db.DateTime(3)
  history           BookingHistory[]

  @@unique([portalId, bookingId])
  @@index([portalId, createdByUserId, createdAt])
  @@index([portalId, createdByUserId, cancelledAt])
}

/// История брони (аудит): только добавление — UPDATE/DELETE запрещены триггерами БД.
model BookingHistory {
  id        String           @id @default(cuid())
  recordId  String
  record    BookingRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// `created` | `imported` | `changed_in_bitrix` | `removed_in_bitrix` | `cancelled` | …
  action    String           @db.VarChar(32)
  actorKind BookingActorKind @default(user)
  /// Сотрудник Битрикс24 (для `user`); null — система или Битрикс24.
  userId    Int?
  /// Подпись для людей: имя сотрудника, «Система: автоматизация — …», «Битрикс24».
  actorName String?          @db.VarChar(255)
  /// Откуда пришло действие: `app` | `reconcile` | `worker` | `event`.
  via       String           @default("app") @db.VarChar(16)
  /// Состояние до и после (время, ресурсы, сделка) — что именно изменилось.
  before    Json?
  after     Json?
  details   Json?
  at        DateTime         @default(now()) @db.DateTime(3)

  @@index([recordId, at])
}

// ---------- Синхронизация с Битрикс24 ----------

/// Зеркало ресурсов модуля бронирования Битрикс24 (`booking.v1.resource`). Удалённый в портале
/// ресурс не удаляется, а архивируется — на него ссылаются брони и история.
model Resource {
  id         String    @id @default(cuid())
  portalId   String
  portal     Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  resourceId Int
  name       String    @db.VarChar(255)
  /// Имя для клиента в сообщениях («Дом знахаря»); null — как в Битрикс24. Ведёт приложение.
  clientName String?   @db.VarChar(255)
  archivedAt DateTime? @db.DateTime(3)
  syncedAt   DateTime  @db.DateTime(3)

  @@unique([portalId, resourceId])
}

enum BookingAlertKind {
  /// Новая бронь в Битрикс24, созданная не через приложение.
  new_booking
  /// Бронь приложения в Битрикс24 не совпадает с ожидаемой (время, ресурсы, сделка, удалена).
  discrepancy
}

enum BookingAlertStatus {
  new
  viewed
  resolved
  ignored
}

/// Уведомление о брони: уходит в чат уведомлений, статус меняют сотрудники в приложении.
model BookingAlert {
  id             String             @id @default(cuid())
  portalId       String
  portal         Portal             @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind           BookingAlertKind
  /// Что не совпало: `missing`, `time`, `resources`, `deal` (через запятую); у новой брони — null.
  problem        String?            @db.VarChar(64)
  bookingId      Int
  dealId         Int?
  /// Как в приложении и как в Битрикс24 на момент обнаружения.
  expected       Json?
  actual         Json?
  /// Одинаковое расхождение не порождает второе уведомление.
  fingerprint    String             @db.VarChar(191)
  status         BookingAlertStatus @default(new)
  statusByUserId Int?
  statusByName   String?            @db.VarChar(255)
  statusAt       DateTime?          @db.DateTime(3)
  /// Сообщение в чате уведомлений (для обновления статуса в нём); null — не отправлено.
  chatId         Int?
  messageId      Int?
  sendError      String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.DateTime(3)

  @@unique([portalId, fingerprint])
  @@index([portalId, status, createdAt])
}
