// Единственный файл схемы БД (MariaDB/MySQL). Модели добавляются по доменам, каждый домен —
// отдельным блоком с комментарием `// ---------- <Домен> ----------`.
// Правила изменения схемы: AGENTS.md → «База данных и миграции», skill add-prisma-migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Bitrix24: порталы и входящие события ----------

/// Установка приложения на портал Битрикс24 (тенант). Токены — только в зашифрованном виде.
model Portal {
  id                   String               @id @default(cuid())
  /// Неизменный идентификатор портала (не зависит от смены домена).
  memberId             String               @unique @db.VarChar(64)
  domain               String               @db.VarChar(255)
  /// База REST портала, например https://portal.bitrix24.ru/rest/ (из ответа сервера авторизации).
  clientEndpoint       String               @db.VarChar(255)
  /// REST сервера авторизации (облако — https://oauth.bitrix.info/rest/, «коробка» — сам портал).
  serverEndpoint       String               @db.VarChar(255)
  /// sha256(application_token) — проверка подлинности входящих событий.
  applicationTokenHash String?              @db.Char(64)
  accessTokenEnc       String?              @db.Text
  refreshTokenEnc      String?              @db.Text
  accessExpiresAt      DateTime?            @db.DateTime(3)
  scope                String               @default("") @db.VarChar(1000)
  /// Часовой пояс портала для расчёта периодов и отображения.
  timezone             String               @default("Europe/Moscow") @db.VarChar(64)
  status               PortalStatus         @default(ACTIVE)
  installedByUserId    Int?
  installedAt          DateTime             @default(now()) @db.DateTime(3)
  uninstalledAt        DateTime?            @db.DateTime(3)
  createdAt            DateTime             @default(now()) @db.DateTime(3)
  updatedAt            DateTime             @updatedAt @db.DateTime(3)
  events               Bitrix24Event[]
  groups               WorkGroup[]
  admins               AppAdmin[]
  appUsers             AppUser[]
  settings             PortalSettings?
  externalUsers        ExternalUser[]
  sandboxBookings      SandboxBooking[]
  appCreatedEntities   AppCreatedEntity[]
  paymentRequests      PaymentRequest[]
  messageTemplates     MessageTemplate[]
  storedFiles          StoredFile[]
  openlineChats        OpenlineChat[]
  openlineChatAccess   OpenlineChatAccess[]
  chatFolders          ChatFolder[]
  bookingRecords       BookingRecord[]
  settingsAccessCodes  SettingsAccessCode[]
  bookingOperations    BookingOperation[]
  resources            Resource[]
  bookingAlerts        BookingAlert[]
  actionLogs           ActionLog[]
  webSessions          WebSession[]
  systemMessages       SystemMessage[]
  autoMessages         AutoMessageLog[]
  appHeads             AppHead[]
  dashboardHiddenChats DashboardHiddenChat[]
  dealPaidAmounts      DealPaidAmount[]
  dealPayments         DealPayment[]
  certificates         Certificate[]
  certificateEvents    CertificateEvent[]
  chatFavorites        ChatFavorite[]
  resourceStops        ResourceStop[]
  telephonyCalls       TelephonyCall[]
  dashboardLayouts     DashboardLayout[]
  crmDeals             CrmDeal[]
  crmEntities          CrmEntity[]
  crmCalls             CrmCall[]
  portalEmployees      PortalEmployee[]
  crmSyncStates        CrmSyncState[]
  crmAccessChecks      CrmAccessCheck[]
  messengers           Messenger[]
  workdayStates        WorkdayState[]
  workdayEvents        WorkdayEvent[]
  callExclusions       CallExclusion[]
}

enum PortalStatus {
  ACTIVE
  UNINSTALLED
}

/// Входящее событие Битрикс24: сначала сохраняем, потом обрабатываем (повторная доставка возможна).
model Bitrix24Event {
  id          String      @id @default(cuid())
  portalId    String
  portal      Portal      @relation(fields: [portalId], references: [id], onDelete: Cascade)
  event       String      @db.VarChar(100)
  payload     Json
  status      EventStatus @default(PENDING)
  error       String?     @db.Text
  receivedAt  DateTime    @default(now()) @db.DateTime(3)
  processedAt DateTime?   @db.DateTime(3)

  @@index([status, receivedAt])
  @@index([portalId, event])
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------- Группы, роли, настройки приложения (ADR 0005) ----------

enum MemberKind {
  USER
  DEPARTMENT
}

enum GroupRole {
  VIEWER
  TECHNOLOGIST
  MANAGER
  GROUP_ADMIN
}

enum BookingMode {
  duration
  interval
}

/// Рабочее направление портала: воронка + ресурсы + настройки + люди с ролями.
model WorkGroup {
  id                String              @id @default(cuid())
  portalId          String
  portal            Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(100)
  sort              Int                 @default(0)
  /// Воронка сделок направления (CATEGORY_ID); null — без привязки.
  dealCategoryId    Int?
  bookingMode       BookingMode         @default(duration)
  durationMinutes   Int                 @default(60)
  checkInTime       String              @default("14:00") @db.Char(5)
  checkOutTime      String              @default("12:00") @db.Char(5)
  defaultNights     Int                 @default(1)
  techWindowMinutes Int                 @default(0)
  /// Включённые функции группы (GROUP_FEATURES из @btx24/shared).
  features          Json
  /// Настройки направления без отдельных колонок (оплаты, поля сделки, каталог, товары по
  /// умолчанию, виды) — схема `groupOptionsSchema`; переносятся из прототипа без потерь.
  options           Json?
  /// id группы в прототипе Node-RED — повторный импорт обновляет, а не дублирует.
  legacyId          String?             @db.VarChar(64)
  archivedAt        DateTime?           @db.DateTime(3)
  createdAt         DateTime            @default(now()) @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @db.DateTime(3)
  resources         WorkGroupResource[]
  members           WorkGroupMember[]
  externalUsers     ExternalUserGroup[]

  @@unique([portalId, legacyId])
  @@index([portalId, archivedAt])
}

/// Ресурс модуля бронирования Битрикс24 в группе. Один ресурс может входить в несколько групп.
model WorkGroupResource {
  groupId    String
  group      WorkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resourceId Int

  @@id([groupId, resourceId])
}

/// Участник группы: сотрудник или отдел Битрикс24 (с вложенными отделами).
model WorkGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  group    WorkGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int
  role     GroupRole

  @@unique([groupId, kind, bitrixId])
}

/// Администраторы приложения (помимо администраторов портала, которые имеют доступ всегда).
model AppAdmin {
  id       String     @id @default(cuid())
  portalId String
  portal   Portal     @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int

  @@unique([portalId, kind, bitrixId])
}

/// Кто может открыть приложение (решение владельца 2026-10-22): сотрудники и отделы (с вложенными).
/// Администраторы портала и приложения входят всегда; остальные видят «Доступ ограничен».
model AppUser {
  id       String     @id @default(cuid())
  portalId String
  portal   Portal     @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int

  @@unique([portalId, kind, bitrixId])
}

/// Руководители (решение владельца 2026-10-23): свой дашборд — графики, показатели и активность
/// сотрудников. Сотрудники и отделы (с вложенными); входят в приложение всегда.
model AppHead {
  id       String     @id @default(cuid())
  portalId String
  portal   Portal     @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind     MemberKind
  bitrixId Int

  @@unique([portalId, kind, bitrixId])
}

/// Настройки приложения на портале. Сбор данных диалогов — по умолчанию выключен.
model PortalSettings {
  portalId              String    @id
  portal                Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  dialogMetadataEnabled Boolean   @default(false)
  dialogTextsEnabled    Boolean   @default(false)
  /// Перед запуском оплаты удалять у контакта e-mail с «wazzup» (платёжный сервис отклоняет).
  removeWazzupEmail     Boolean   @default(false)
  /// Чат Битрикс24 для уведомлений о бронях (новая бронь мимо приложения, расхождения).
  alertChatId           Int?
  /// Сверка броней с Битрикс24: на сколько дней вперёд от сегодня.
  syncHorizonDays       Int       @default(180)
  /// Первая полная сверка прошла: существующие брони приняты без уведомлений.
  bookingSyncBaselineAt DateTime? @db.DateTime(3)
  /// Последняя сверка броней и её ошибка (для экрана настроек).
  bookingSyncAt         DateTime? @db.DateTime(3)
  bookingSyncError      String?   @db.VarChar(500)
  /// Системные поля сделки портала: роль → код поля (`DealFieldMapDto` в @btx24/shared).
  dealFieldMap          Json?
  /// Разрешение владельца создавать в Битрикс24 новые брони и сделки при B24_READ_ONLY (2026-10-22).
  createInBitrix        Boolean   @default(false)
  createGrantedByUserId Int?
  createGrantedAt       DateTime? @db.DateTime(3)
  /// Разрешение владельца менять поля существующих сделок (2026-10-22); удалять — нельзя.
  updateDealFields      Boolean   @default(false)
  updatedByUserId       Int?
  updatedAt             DateTime  @updatedAt @db.DateTime(3)
}

enum ExternalRole {
  VIEWER
  TECHNOLOGIST
}

/// Пользователь прямой ссылки (вне Битрикс24): только просмотр. Пароль — только хеш (scrypt).
model ExternalUser {
  id            String              @id @default(cuid())
  portalId      String
  portal        Portal              @relation(fields: [portalId], references: [id], onDelete: Cascade)
  login         String              @db.VarChar(100)
  passwordHash  String              @db.VarChar(255)
  role          ExternalRole
  /// true — доступ ко всем группам портала (как в прототипе при пустом списке групп).
  allGroups     Boolean             @default(false)
  /// null — видны все поля сделки; иначе список кодов полей.
  visibleFields Json?
  disabledAt    DateTime?           @db.DateTime(3)
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @db.DateTime(3)
  groups        ExternalUserGroup[]

  @@unique([portalId, login])
}

model ExternalUserGroup {
  externalUserId String
  externalUser   ExternalUser @relation(fields: [externalUserId], references: [id], onDelete: Cascade)
  groupId        String
  group          WorkGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([externalUserId, groupId])
}

/// Брони, созданные в песочнице записи (B24_SANDBOX_*): только их можно менять/удалять, и
/// только их удаляет уборка. Реальные брони песочнице недоступны.
model SandboxBooking {
  id        String    @id @default(cuid())
  portalId  String
  portal    Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  bookingId Int
  createdAt DateTime  @default(now()) @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  @@unique([portalId, bookingId])
}

/// Брони и сделки, созданные приложением по разрешению `PortalSettings.createInBitrix`: только их
/// приложение может дальше менять (связи брони, поля и товары новой сделки, отмена своей брони).
model AppCreatedEntity {
  id         String   @id @default(cuid())
  portalId   String
  portal     Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// 'booking' | 'deal'
  entityType String   @db.VarChar(20)
  entityId   Int
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@unique([portalId, entityType, entityId])
}

// ---------- Открытые линии ----------

/// Личный шаблон сообщений менеджера: цепочка шагов (текст + вложения), отправляется по порядку.
/// Видит и меняет только автор (`ownerUserId` — ID сотрудника Битрикс24).
enum MessageTemplatePurpose {
  chat
  payment
  /// Автоматическая рассылка по брони (например, «подтвердите бронь» за сутки) — системный.
  auto
}

model MessageTemplate {
  id          String                 @id @default(cuid())
  portalId    String
  portal      Portal                 @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ownerUserId Int
  name        String                 @db.VarChar(100)
  /// Общий (системный) шаблон: видят все сотрудники портала, меняют администраторы приложения.
  shared      Boolean                @default(false)
  /// Назначение: шаблон чата или системный шаблон сообщения об оплате (выбирается в настройках группы).
  purpose     MessageTemplatePurpose @default(chat)
  /// `[{ text, fileIds }]` в порядке отправки (`TemplateStepDto` в @btx24/shared).
  steps       Json
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)

  @@index([portalId, ownerUserId])
  @@index([portalId, shared])
}

/// Файл вложения для отправки в чат (из шаблона или разовый). Хранится в БД, до 10 МБ: отдаётся
/// в Битрикс24 через im.v2.File.upload. Доступен только автору.
model StoredFile {
  id          String   @id @default(cuid())
  portalId    String
  portal      Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ownerUserId Int
  name        String   @db.VarChar(255)
  mime        String   @db.VarChar(150)
  size        Int
  data        Bytes    @db.LongBlob
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([portalId, ownerUserId])
}

/// Индекс диалогов открытых линий для сортировки «по дате последнего сообщения» — как в списке
/// диалогов Битрикс24. Только метаданные: ни текстов, ни имён. Ведёт worker, пока включён «сбор
/// метаданных диалогов» (`PortalSettings.dialogMetadataEnabled`). Видимость каждому пользователю
/// проверяется его токеном при показе — индекс прав не даёт.
model OpenlineChat {
  id               String    @id @default(cuid())
  portalId         String
  portal           Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  chatId           Int
  /// Последняя сессия чата (ID в списке диалогов Битрикс24).
  sessionId        Int
  responsibleId    Int?
  completed        Boolean
  connector        String    @db.VarChar(64)
  /// Последнее сообщение клиента или оператора (без системных и ботов).
  lastMessageAt    DateTime? @db.DateTime(3)
  lastAuthor       String?   @db.VarChar(10)
  checkedAt        DateTime  @db.DateTime(3)
  /// Сводка для списка чатов (кэш, одна строка на чат — общая для всех сотрудников; кто её видит,
  /// решает OpenlineChatAccess). Текст превью — только при включённом «сборе текстов».
  title            String?   @db.VarChar(255)
  /// Имя клиента: контакт (или компания/лид) из привязок CRM; title чата — это название сделки/линии.
  clientName       String?   @db.VarChar(255)
  /// Аватарка клиента в открытой линии (URL из im.dialog.messages.get), для дашборда.
  clientAvatar     String?   @db.VarChar(1000)
  /// Привязки к CRM: { leadId, contactId, companyId, dealId }.
  crm              Json?
  phones           Json?
  lastMessageId    Int?
  lastPreview      String?   @db.VarChar(500)
  lastHasFiles     Boolean   @default(false)
  /// Сообщений клиента подряд после последнего ответа сотрудника — «непрочитанные» на дашборде.
  clientStreak     Int       @default(0)
  /// Когда сводку обновили (worker или живой запрос сотрудника).
  summaryAt        DateTime? @db.DateTime(3)
  /// «Не требует ответа» — общая отметка для всех сотрудников (решение владельца 2026-10-22): действует,
  /// пока последнее сообщение клиента — это `noReplyMessageId`; новое сообщение клиента снова «ждёт ответа».
  noReplyMessageId Int?
  noReplyByUserId  Int?
  noReplyByName    String?   @db.VarChar(255)
  noReplyAt        DateTime? @db.DateTime(3)

  @@unique([portalId, chatId])
  @@index([portalId, lastMessageAt])
  @@index([portalId, responsibleId, lastMessageAt])
}

/// Чат, скрытый сотрудником с его дашборда (решение владельца 2026-10-23): в списке чатов остаётся.
model DashboardHiddenChat {
  id       String   @id @default(cuid())
  portalId String
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId   Int
  chatId   Int
  hiddenAt DateTime @db.DateTime(3)

  @@unique([portalId, userId, chatId])
}

/// Последняя увиденная «Сумма внесённых оплат» сделки (worker): рост суммы — оплата (`DealPayment`).
/// Битрикс24 не хранит, когда поле изменилось, а оплаты на портале — только в этом поле.
model DealPaidAmount {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  dealId    Int
  amount    Decimal  @db.Decimal(14, 2)
  checkedAt DateTime @db.DateTime(3)

  @@unique([portalId, dealId])
}

/// Поступление оплаты по сделке: на сколько выросла «Сумма внесённых оплат» и когда это заметили
/// (время изменения сделки) — «сделки с оплатой сегодня» на дашборде.
model DealPayment {
  id       String   @id @default(cuid())
  portalId String
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  dealId   Int
  amount   Decimal  @db.Decimal(14, 2)
  total    Decimal  @db.Decimal(14, 2)
  at       DateTime @db.DateTime(3)

  @@index([portalId, at])
}

/// Доступ сотрудника к чату — как решил Битрикс24 (imopenlines.dialog.get его токеном): кэш, чтобы
/// список чатов строился из базы. Сводка чата общая (OpenlineChat), доступ — свой у каждого.
model OpenlineChatAccess {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId    Int
  chatId    Int
  allowed   Boolean
  /// Сотрудник — участник чата (может писать без «Присоединиться»).
  joined    Boolean  @default(false)
  checkedAt DateTime @db.DateTime(3)

  @@unique([portalId, userId, chatId])
}

// ---------- Журнал броней ----------

enum BookingKind {
  /// Клиентская бронь, привязана к сделке.
  client
  /// Служебная блокировка ресурса, без сделки.
  service
}

enum BookingStatus {
  active
  cancelled
}

enum BookingCancelReason {
  /// Оплата не поступила за `paymentTimeoutMinutes` (снимает worker).
  payment_timeout
  /// Отменил сотрудник.
  manual
  /// Брони больше нет в Битрикс24 (удалили в портале), решение принято по уведомлению.
  removed_in_bitrix
}

/// Сценарий оплаты брони (ADR 0008).
enum BookingPaymentMode {
  /// Предоплата по ссылке, таймер, доплата.
  prepayment
  /// Предоплата наличными на месте — без ссылки и таймера.
  cash_on_site
  /// Без предоплаты: оплата после визита.
  postpay
  /// Бесплатно.
  free
  /// Оплачено сертификатом.
  certificate
}

/// Откуда бронь: создана приложением или найдена в Битрикс24 (онлайн-запись, вручную в портале).
enum BookingSource {
  app
  bitrix
}

/// Кто выполнил действие с бронью.
enum BookingActorKind {
  /// Сотрудник Битрикс24 (через приложение).
  user
  /// Автоматизация приложения (worker): неоплата, сверка.
  system
  /// Изменение в самом Битрикс24 — автор неизвестен (события не сообщают, кто).
  bitrix
}

/// Запись приложения о брони, созданной через него (ADR 0006): то, чего у брони в Битрикс24 нет —
/// тип, статус, автор, причина отмены. Время и ресурсы — снимок на момент создания (после отмены
/// брони в Битрикс24 уже нет); истина о слотах — модуль бронирования Битрикс24 (ADR 0003).
model BookingRecord {
  id                String               @id @default(cuid())
  portalId          String
  portal            Portal               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// ID брони в Битрикс24 (`booking.v1.booking`).
  bookingId         Int
  source            BookingSource        @default(app)
  /// Название брони в Битрикс24 (снимок).
  title             String?              @db.VarChar(255)
  kind              BookingKind
  dealId            Int?
  groupId           String?              @db.VarChar(191)
  /// ID ресурсов Битрикс24 (снимок).
  resourceIds       Json
  startsAt          DateTime             @db.DateTime(3)
  endsAt            DateTime             @db.DateTime(3)
  status            BookingStatus        @default(active)
  /// Как оплачивается (ADR 0008); null — бронь не из приложения.
  paymentMode       BookingPaymentMode?
  cancelReason      BookingCancelReason?
  /// Сотрудник Битрикс24, создавший бронь; null — бронь найдена в Битрикс24 (автор неизвестен).
  createdByUserId   Int?
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  cancelledAt       DateTime?            @db.DateTime(3)
  /// null — отменила система (неоплата).
  cancelledByUserId Int?
  /// Последняя сверка, на которой бронь была в Битрикс24 в ожидаемом виде.
  syncedAt          DateTime?            @db.DateTime(3)
  history           BookingHistory[]

  @@unique([portalId, bookingId])
  @@index([portalId, createdByUserId, createdAt])
  @@index([portalId, createdByUserId, cancelledAt])
}

/// История брони (аудит): только добавление — UPDATE/DELETE запрещены триггерами БД.
model BookingHistory {
  id        String           @id @default(cuid())
  recordId  String
  record    BookingRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// `created` | `imported` | `changed_in_bitrix` | `removed_in_bitrix` | `cancelled` | …
  action    String           @db.VarChar(32)
  actorKind BookingActorKind @default(user)
  /// Сотрудник Битрикс24 (для `user`); null — система или Битрикс24.
  userId    Int?
  /// Подпись для людей: имя сотрудника, «Система: автоматизация — …», «Битрикс24».
  actorName String?          @db.VarChar(255)
  /// Откуда пришло действие: `app` | `reconcile` | `worker` | `event`.
  via       String           @default("app") @db.VarChar(16)
  /// Состояние до и после (время, ресурсы, сделка) — что именно изменилось.
  before    Json?
  after     Json?
  details   Json?
  at        DateTime         @default(now()) @db.DateTime(3)

  @@index([recordId, at])
}

// ---------- Синхронизация с Битрикс24 ----------

/// Зеркало ресурсов модуля бронирования Битрикс24 (`booking.v1.resource`). Удалённый в портале
/// ресурс не удаляется, а архивируется — на него ссылаются брони и история.
model Resource {
  id         String    @id @default(cuid())
  portalId   String
  portal     Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  resourceId Int
  name       String    @db.VarChar(255)
  /// Имя для клиента в сообщениях («Дом знахаря»); null — как в Битрикс24. Ведёт приложение.
  clientName String?   @db.VarChar(255)
  archivedAt DateTime? @db.DateTime(3)
  syncedAt   DateTime  @db.DateTime(3)

  @@unique([portalId, resourceId])
}

enum BookingAlertKind {
  /// Новая бронь в Битрикс24, созданная не через приложение.
  new_booking
  /// Бронь приложения в Битрикс24 не совпадает с ожидаемой (время, ресурсы, сделка, удалена).
  discrepancy
}

enum BookingAlertStatus {
  new
  viewed
  resolved
  ignored
}

/// Уведомление о брони: уходит в чат уведомлений, статус меняют сотрудники в приложении.
model BookingAlert {
  id             String             @id @default(cuid())
  portalId       String
  portal         Portal             @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind           BookingAlertKind
  /// Что не совпало: `missing`, `time`, `resources`, `deal` (через запятую); у новой брони — null.
  problem        String?            @db.VarChar(64)
  bookingId      Int
  dealId         Int?
  /// Как в приложении и как в Битрикс24 на момент обнаружения.
  expected       Json?
  actual         Json?
  /// Одинаковое расхождение не порождает второе уведомление.
  fingerprint    String             @db.VarChar(191)
  status         BookingAlertStatus @default(new)
  statusByUserId Int?
  statusByName   String?            @db.VarChar(255)
  statusAt       DateTime?          @db.DateTime(3)
  /// Сообщение в чате уведомлений (для обновления статуса в нём); null — не отправлено.
  chatId         Int?
  messageId      Int?
  sendError      String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @db.DateTime(3)

  @@unique([portalId, fingerprint])
  @@index([portalId, status, createdAt])
}

// ---------- Временный доступ к настройкам ----------

/// Временный пароль к настройкам: создаёт администратор приложения, сотрудник вводит его и до
/// `expiresAt` работает как администратор приложения. Одноразовый; хранится только хеш.
model SettingsAccessCode {
  id              String    @id @default(cuid())
  portalId        String
  portal          Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// sha256(portalId + ':' + код).
  codeHash        String    @db.Char(64)
  createdByUserId Int
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  expiresAt       DateTime  @db.DateTime(3)
  usedByUserId    Int?
  usedAt          DateTime? @db.DateTime(3)
  revokedAt       DateTime? @db.DateTime(3)

  @@unique([portalId, codeHash])
  @@index([portalId, usedByUserId, expiresAt])
}

/// Журнал операции создания брони (сага «сделка → бронь → связь → поля → товары»): шаги, результат
/// и ошибка. Ключ идемпотентности: повтор той же заявки не создаёт вторую бронь.
model BookingOperation {
  id             String   @id @default(cuid())
  portalId       String
  portal         Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  idempotencyKey String   @db.VarChar(64)
  userId         Int
  /// `running` | `done` | `failed`.
  status         String   @db.VarChar(16)
  /// Пройденные шаги и компенсация — по порядку.
  steps          Json
  bookingId      Int?
  dealId         Int?
  error          String?  @db.VarChar(1000)
  request        Json
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  @@unique([portalId, idempotencyKey])
  @@index([portalId, createdAt])
}

/// Личная папка чатов сотрудника (охрана, ресепшн, АХО…): чаты папки уходят из общего списка.
model ChatFolder {
  id              String           @id @default(cuid())
  portalId        String
  portal          Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ownerUserId     Int
  name            String           @db.VarChar(60)
  sort            Int              @default(0)
  /// «Не обращать внимания»: чаты папки не попадают в «Требуют внимания» и «ждут ответа» на дашборде владельца.
  ignoreAttention Boolean          @default(false)
  /// Глобальная (решение владельца 2026-10-23): папку и доступные им чаты видят все сотрудники, и
  /// «Не обращать внимания» действует у всех. Меняет только владелец.
  global          Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  items           ChatFolderItem[]

  @@index([portalId, ownerUserId])
  @@index([portalId, global])
}

/// Избранный чат сотрудника (личное): «★ Избранное» вверху списка чатов.
model ChatFavorite {
  id       String   @id @default(cuid())
  portalId String
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId   Int
  chatId   Int
  addedAt  DateTime @default(now()) @db.DateTime(3)

  @@unique([portalId, userId, chatId])
}

/// Чат в папке. У сотрудника чат может быть только в одной папке.
model ChatFolderItem {
  id          String     @id @default(cuid())
  folderId    String
  folder      ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  portalId    String     @db.VarChar(191)
  ownerUserId Int
  chatId      Int
  addedAt     DateTime   @default(now()) @db.DateTime(3)

  @@unique([portalId, ownerUserId, chatId])
  @@index([folderId])
}

enum PaymentKind {
  prepayment
  surcharge
}

enum PaymentRequestStatus {
  link_pending
  sent
  paid
  expired
  failed
  cancelled
}

/// Счёт и ссылка на оплату (ADR 0009): смарт-счёт создаёт приложение, ссылку ставит портал,
/// worker доводит до сообщения клиенту и следит за оплатой до срока.
model PaymentRequest {
  id              String               @id @default(cuid())
  portalId        String
  portal          Portal               @relation(fields: [portalId], references: [id], onDelete: Cascade)
  idempotencyKey  String               @db.VarChar(64)
  dealId          Int
  bookingId       Int?
  groupId         String?              @db.VarChar(191)
  kind            PaymentKind
  amount          Decimal              @db.Decimal(12, 2)
  invoiceId       Int?
  /// Ссылка на оплату от портала; в логи и ошибки не пишется.
  link            String?              @db.VarChar(1000)
  status          PaymentRequestStatus @default(link_pending)
  /// Срок оплаты (предоплата); null — без срока.
  deadlineAt      DateTime?            @db.DateTime(3)
  messageSentAt   DateTime?            @db.DateTime(3)
  paidAt          DateTime?            @db.DateTime(3)
  closedAt        DateTime?            @db.DateTime(3)
  createdByUserId Int
  createdByName   String?              @db.VarChar(255)
  error           String?              @db.VarChar(1000)
  warnings        Json?
  attempts        Int                  @default(0)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)

  @@unique([portalId, idempotencyKey])
  @@index([portalId, dealId])
  @@index([status, deadlineAt])
}

// ---------- Системные сообщения ----------

/// Сообщения клиенту, которые приложение отправило само (ссылка на оплату, подтверждение — часто
/// от имени сотрудника): в «Активности сотрудников» не считаются его работой.
/// Автосообщение клиенту по правилу группы (`options.autoMessages`) — одно на правило и бронь.
model AutoMessageLog {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  ruleId    String   @db.VarChar(40)
  bookingId Int
  dealId    Int
  /// sending → sent / failed. failed не повторяется (клиент мог получить часть цепочки).
  status    String   @db.VarChar(16)
  error     String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  sentAt    DateTime? @db.DateTime(3)

  @@unique([portalId, ruleId, bookingId])
  @@index([portalId, createdAt])
}

model SystemMessage {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  chatId    Int
  /// ID сообщения, если метод его вернул; иначе сверка по чату, отправителю и времени.
  messageId Int?
  /// От чьего имени ушло (USER_ID); null — от имени приложения.
  userId    Int?
  source    String   @db.VarChar(32)
  sentAt    DateTime @default(now()) @db.DateTime(3)

  @@index([portalId, sentAt])
}

// ---------- Журнал действий ----------

/// Журнал действий в приложении (решение владельца 2026-10-22, ⚙ → «Журнал действий»): кто, что,
/// когда и откуда — вход, правка сделки «было → стало», бронь, оплата, настройки, действия системы.
/// Только добавление: UPDATE/DELETE запрещены триггерами БД (как у `BookingHistory`).
model ActionLog {
  id         String           @id @default(cuid())
  portalId   String
  portal     Portal           @relation(fields: [portalId], references: [id], onDelete: Cascade)
  at         DateTime         @default(now()) @db.DateTime(3)
  actorKind  BookingActorKind @default(user)
  /// Сотрудник Битрикс24 (для `user`).
  userId     Int?
  actorName  String?          @db.VarChar(255)
  /// Код действия: `app.enter`, `deal.edit_open`, `deal.update`, `booking.cancelled`, `request` …
  action     String           @db.VarChar(64)
  /// Объект: `deal` | `booking` | `group` | `settings` | `chat` | `invoice` …
  entityType String?          @db.VarChar(32)
  entityId   String?          @db.VarChar(64)
  /// Одной строкой для людей: «Открыл редактирование сделки #678».
  summary    String           @db.VarChar(500)
  /// Подробности: изменения `[{field, label, before, after}]`, контекст, параметры запроса.
  details    Json?
  /// Откуда: `deal_tab` | `app` | `worker` | `reconcile` | `api` …
  via        String?          @db.VarChar(32)

  @@index([portalId, at])
  @@index([portalId, entityType, entityId, at])
  @@index([portalId, userId, at])
}

// ---------- Вход через Битрикс24 вне портала ----------

/// Сессия входа в приложение напрямую (не из фрейма портала) через OAuth Битрикс24 (решение владельца
/// 2026-10-22). В cookie — только случайный секрет; здесь — его sha256 и токены сотрудника (зашифрованы).
model WebSession {
  id              String   @id @default(cuid())
  portalId        String
  portal          Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// sha256(секрет из cookie) — по украденной базе сессию не подделать.
  tokenHash       String   @unique @db.VarChar(64)
  userId          Int
  userName        String   @db.VarChar(255)
  accessTokenEnc  String   @db.Text
  refreshTokenEnc String   @db.Text
  accessExpiresAt DateTime @db.DateTime(3)
  /// Сервер авторизации (oauth.bitrix24.tech) — для обновления токенов.
  oauthHost       String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  lastSeenAt      DateTime @default(now()) @db.DateTime(3)
  expiresAt       DateTime @db.DateTime(3)

  @@index([portalId, userId])
}

// ---------- Сертификаты (решение владельца 2026-10-23) ----------

enum CertificateKind {
  paper
  electronic
}

enum CertificateStatus {
  new
  used
  expired
}

/// Подарочный сертификат: номер, номинал, на чьё имя, статус, дата оплаты, срок действия. Действия —
/// выпуск, изменение срока, погашение (использован / истёк) — в `CertificateEvent`.
model Certificate {
  id              String            @id @default(cuid())
  portalId        String
  portal          Portal            @relation(fields: [portalId], references: [id], onDelete: Cascade)
  number          String            @db.VarChar(32)
  nominal         Decimal           @db.Decimal(14, 2)
  holderName      String            @db.VarChar(255)
  status          CertificateStatus @default(new)
  /// День оплаты (дата портала, полночь UTC — без времени).
  paidOn          DateTime?         @db.Date
  /// Действителен по этот день включительно (дата портала).
  validUntil      DateTime          @db.Date
  /// Сделка продажи сертификата (необязательно).
  dealId          Int?
  comment         String?           @db.VarChar(1000)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  createdByUserId Int
  redeemedAt      DateTime?         @db.DateTime(3)
  /// Бумажный или электронный; null — не указан (выпущен до появления поля).
  kind            CertificateKind?
  /// Ключ продажи из мастера брони: повтор запроса не выпускает второй сертификат.
  saleKey         String?           @db.VarChar(64)
  events          CertificateEvent[]

  @@unique([portalId, number])
  @@unique([portalId, saleKey])
  @@index([portalId, status, validUntil])
}

/// История сертификата: выпуск, изменение срока, погашение — кто, когда, было → стало.
model CertificateEvent {
  id            String      @id @default(cuid())
  portalId      String
  portal        Portal      @relation(fields: [portalId], references: [id], onDelete: Cascade)
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  /// issued | changed | redeemed
  action        String      @db.VarChar(16)
  userId        Int
  userName      String      @db.VarChar(255)
  at            DateTime    @default(now()) @db.DateTime(3)
  details       Json?

  @@index([portalId, certificateId, at])
}

// ---------- Стоп ресурса (решение владельца 2026-10-23) ----------

/// Ресурс закрыт для бронирования на дни `[startsAt, endsAt)` (границы дней портала, UTC) с причиной.
/// Ставится, только если броней в этот период нет; снимается сотрудником (`liftedAt`).
model ResourceStop {
  id              String    @id @default(cuid())
  portalId        String
  portal          Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  resourceId      Int
  startsAt        DateTime  @db.DateTime(3)
  endsAt          DateTime  @db.DateTime(3)
  reason          String    @db.VarChar(500)
  createdByUserId Int
  createdByName   String    @db.VarChar(255)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  liftedAt        DateTime? @db.DateTime(3)
  liftedByName    String?   @db.VarChar(255)

  @@index([portalId, resourceId, startsAt])
}

// ---------- Звонки телефонии и личный дашборд (решение владельца 2026-10-23) ----------

/// Звонок по событиям телефонии Битрикс24 (OnVoximplantCallInit/Start/End): номер клиента — из начала,
/// сотрудник — кто ответил; приложение показывает ему карточку клиента. Повтор события — тот же звонок.
model TelephonyCall {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  callId        String    @db.VarChar(100)
  /// CALL_TYPE: 1 исходящий, 2 входящий, 3 входящий с переадресацией, 4 обратный, 5 инфозвонок.
  callType      Int?
  /// Номер клиента.
  phone         String?   @db.VarChar(40)
  /// Сотрудник, ответивший на звонок (или оператор звонка из завершения).
  userId        Int?
  startedAt     DateTime  @db.DateTime(3)
  answeredAt    DateTime? @db.DateTime(3)
  endedAt       DateTime? @db.DateTime(3)
  crmActivityId Int?

  @@unique([portalId, callId])
  @@index([portalId, userId, answeredAt])
}

/// Личный дашборд сотрудника: блоки по порядку и ширина каждого (четверть, треть, половина, ряд).
model DashboardLayout {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId    Int
  /// [{ id, type, width }] — схема `DashboardLayoutDto`.
  blocks    Json
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([portalId, userId])
}

// ---------- Копия CRM для дашборда (ADR 0013, решение владельца 2026-10-24) ----------

/// Сделка CRM — копия, которую ведёт worker токеном приложения (события + изменения по дате).
/// Прав не даёт: что показать сотруднику, решает CrmAccessService его токеном (≤5 мин).
/// `row` — строка, как её отдаёт crm.deal.list (поля копии, см. CrmSyncState.fieldsKey).
model CrmDeal {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  dealId        Int
  categoryId    Int?
  contactId     Int?
  assignedById  Int?
  stageSemantic String?   @db.VarChar(1)
  createdAt     DateTime? @db.DateTime(3)
  modifiedAt    DateTime? @db.DateTime(3)
  row           Json
  /// Сделку удалили в Битрикс24 (событие) — в выборки не попадает.
  deletedAt     DateTime? @db.DateTime(3)
  syncedAt      DateTime  @db.DateTime(3)

  @@unique([portalId, dealId])
  @@index([portalId, createdAt])
  @@index([portalId, contactId])
}

/// Лид (1), контакт (3) или компания (4) CRM — имя/название и фото (копия, как CrmDeal).
model CrmEntity {
  id           String    @id @default(cuid())
  portalId     String
  portal       Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  entityTypeId Int
  entityId     Int
  title        String    @db.VarChar(255)
  photo        String?   @db.VarChar(1000)
  row          Json
  deletedAt    DateTime? @db.DateTime(3)
  syncedAt     DateTime  @db.DateTime(3)

  @@unique([portalId, entityTypeId, entityId])
}

/// Звонок телефонии — дело CRM (`VOXIMPLANT_CALL`), копия; `row` — как из crm.activity.list.
/// Видимость — по владельцу дела (сделка, лид, контакт, компания) токеном сотрудника.
model CrmCall {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  activityId    Int
  ownerTypeId   Int
  ownerId       Int
  responsibleId Int?
  startAt       DateTime  @db.DateTime(3)
  row           Json
  /// Линия и сотрудник из статистики телефонии (voximplant.statistic.get), когда звонок завершён.
  portalNumber  String?   @db.VarChar(40)
  portalUserId  Int?
  statsAt       DateTime? @db.DateTime(3)
  deletedAt     DateTime? @db.DateTime(3)
  syncedAt      DateTime  @db.DateTime(3)

  @@unique([portalId, activityId])
  @@index([portalId, startAt])
}

/// Сотрудник портала (user.get, USER_TYPE=employee): имя и аватарка для подписей.
model PortalEmployee {
  id       String   @id @default(cuid())
  portalId String
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId   Int
  name     String   @db.VarChar(255)
  photo    String?  @db.VarChar(1000)
  active   Boolean
  syncedAt DateTime @db.DateTime(3)

  @@unique([portalId, userId])
}

/// Ход синхронизации копии по виду данных (`deal` | `call` | `entity` | `employee`).
model CrmSyncState {
  id             String    @id @default(cuid())
  portalId       String
  portal         Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  kind           String    @db.VarChar(16)
  /// Изменения после этого момента ещё не забраны (с запасом на расхождение часов).
  since          DateTime? @db.DateTime(3)
  /// Первичная загрузка: последний загруженный ID; `backfillDoneAt` — загрузка завершена.
  backfillCursor Int       @default(0)
  backfillDoneAt DateTime? @db.DateTime(3)
  /// Поля сделки в копии (через запятую): сменилось сопоставление полей — загрузка заново.
  fieldsKey      String?   @db.VarChar(2000)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  @@unique([portalId, kind])
}

/// Видит ли сотрудник запись CRM — последний ответ Битрикс24 его токеном (ADR 0013, решение владельца
/// 2026-10-24): показ сразу по этому ответу (хоть через дни), а старше 5 минут — перепроверка в фоне.
/// Тип: 1 лид, 2 сделка, 3 контакт, 4 компания.
model CrmAccessCheck {
  portalId     String
  portal       Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId       Int
  entityTypeId Int
  entityId     Int
  allowed      Boolean
  checkedAt    DateTime @db.DateTime(3)

  @@id([portalId, userId, entityTypeId, entityId])
  @@index([checkedAt])
}

// ---------- Мессенджеры (ADR 0014, решение владельца 2026-10-24) ----------

/// Подключённый мессенджер портала: браузер в сервисе messenger (WhatsApp Web), вход — кодом по номеру
/// или QR. Позже сопоставляется с открытой линией Битрикс24 (написать клиенту первым).
model Messenger {
  id              String    @id @default(cuid())
  portalId        String
  portal          Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// `whatsapp` (сейчас), `telegram`, `max` — следующими.
  kind            String    @db.VarChar(16)
  /// Только цифры, с кодом страны.
  phone           String    @db.VarChar(20)
  /// Способ входа: `code` — код по номеру, `qr` — QR-код.
  auth            String    @default("code") @db.VarChar(8)
  title           String?   @db.VarChar(255)
  /// Последнее состояние из сервиса — для списка, пока сервис недоступен.
  state           String    @default("starting") @db.VarChar(20)
  /// Вошедший аккаунт (wid), например 79991234567@c.us.
  account         String?   @db.VarChar(100)
  lastError       String?   @db.VarChar(500)
  connectedAt     DateTime? @db.DateTime(3)
  createdByUserId Int
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  /// Привязка к открытой линии Битрикс24: `own` — своя линия приложения (коннектор `imconnector`).
  /// Сообщения сотрудников идут через линию (действия видны в Битрикс24), права на чаты — линии.
  /// Без привязки номер работает только в приложении (напрямую через шлюз) для групп `groupIds`.
  /// (`existing` — сопоставление с чужой линией — отменено владельцем 2026-10-24.)
  lineMode        String?   @db.VarChar(10)
  lineId          Int?
  lineName        String?   @db.VarChar(255)
  /// Группы приложения, которым доступен номер (ID WorkGroup); пусто — только администраторам.
  groupIds        Json?
  chats           MessengerChat[]
  messages        MessengerMessage[]

  @@unique([portalId, kind, phone])
}

/// Чат мессенджера (собеседник): одна строка на чат — общая для всех сотрудников.
model MessengerChat {
  id            String    @id @default(cuid())
  portalId      String
  messengerId   String
  messenger     Messenger @relation(fields: [messengerId], references: [id], onDelete: Cascade)
  /// ID чата в мессенджере (`79991234567@c.us`).
  chatId        String    @db.VarChar(100)
  /// Номер собеседника (цифры), если чат личный.
  phone         String?   @db.VarChar(20)
  name          String?   @db.VarChar(255)
  lastMessageAt DateTime? @db.DateTime(3)
  lastText      String?   @db.VarChar(500)
  /// Входящих после последнего ответа.
  unread        Int       @default(0)

  @@unique([messengerId, chatId])
  @@index([messengerId, lastMessageAt])
  /// CRM-сопоставление содержит только ID; имена/сделки в UI перечитываются токеном сотрудника.
  crmContactId Int?
  activeDealId Int?
  crmMatch     Json?
  crmMatchedAt DateTime? @db.DateTime(3)
  @@index([portalId, activeDealId])

}

/// Сообщение мессенджера. Правки не затирают историю (`edits`), удаление — отметка `deletedAt`
/// (решение владельца 2026-10-24: сообщения могут быть отредактированы и удалены).
model MessengerMessage {
  id           String    @id @default(cuid())
  portalId     String
  messengerId  String
  messenger    Messenger @relation(fields: [messengerId], references: [id], onDelete: Cascade)
  chatId       String    @db.VarChar(100)
  /// ID сообщения в мессенджере.
  externalId   String    @db.VarChar(190)
  fromMe       Boolean
  author       String?   @db.VarChar(100)
  body         String    @db.Text
  type         String    @db.VarChar(20)
  hasMedia     Boolean   @default(false)
  /// Вложение: файл в хранилище сервиса мессенджеров (`fileId`), тип, имя, размер; null — нет или
  /// ещё не скачано (история — скачивается по первому запросу).
  mediaId      String?   @db.VarChar(40)
  mediaMime    String?   @db.VarChar(150)
  mediaName    String?   @db.VarChar(255)
  mediaSize    Int?
  quotedId     String?   @db.VarChar(190)
  sentAt       DateTime  @db.DateTime(3)
  /// 0 отправляется · 1 на сервере · 2 доставлено · 3 прочитано.
  ack          Int?
  editedAt     DateTime? @db.DateTime(3)
  /// Прежние тексты: [{ at, body }].
  edits        Json?
  deletedAt    DateTime? @db.DateTime(3)
  /// Откуда: `messenger` (клиент или телефон), `app` (сотрудник в приложении), `bitrix` (оператор открытой линии).
  source       String    @default("messenger") @db.VarChar(10)
  sentByUserId Int?
  /// Сообщение в открытой линии Битрикс24 (своя линия): ID в чате линии.
  b24MessageId Int?
  b24ChatId    Int?
  /// Передано в открытую линию (своя линия); ошибка передачи — `relayError`.
  relayedAt    DateTime? @db.DateTime(3)
  relayError   String?   @db.VarChar(500)

  @@unique([messengerId, externalId])
  @@index([messengerId, chatId, sentAt])
  @@index([messengerId, b24MessageId])
  /// Контекст сообщения фиксируется при получении/отправке, переключение не меняет историю.
  dealId       Int?
  awaitingDeal Boolean @default(false)
  /// Реальный ID диалога коннектора (может включать контекст сделки).
  relayChatId  String? @db.VarChar(190)
  @@index([portalId, messengerId, chatId, dealId, sentAt])

}

// ---------- Рабочий день (решение владельца 2026-10-24) ----------

/// Текущий рабочий день сотрудника — в приложении (быстро и без Битрикс24), синхронно с учётом
/// времени Битрикс24: действие в приложении уходит в Битрикс24 (не дошло — `pendingAction`,
/// повтор при следующем обращении), изменение в Битрикс24 (закрыли день там) — применяется здесь.
model WorkdayState {
  id            String    @id @default(cuid())
  portalId      String
  portal        Portal    @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId        Int
  /// OPENED | PAUSED | CLOSED | EXPIRED (как `timeman.status`).
  status        String    @db.VarChar(10)
  timeStart     DateTime? @db.DateTime(3)
  /// Отработано и перерывы на момент сверки с Битрикс24, HH:MM:SS.
  duration      String?   @db.VarChar(12)
  timeLeaks     String?   @db.VarChar(12)
  /// Кто изменил последним: `app` — из приложения, `bitrix` — в Битрикс24.
  source        String    @db.VarChar(10)
  changedAt     DateTime  @db.DateTime(3)
  /// Последняя успешная сверка с Битрикс24.
  syncedAt      DateTime? @db.DateTime(3)
  /// Действие приложения, ещё не переданное в Битрикс24 (open | pause | close) и комментарий к нему.
  pendingAction String?   @db.VarChar(10)
  pendingReport String?   @db.VarChar(1000)
  syncError     String?   @db.VarChar(500)

  @@unique([portalId, userId])
}

/// История рабочего дня в приложении: начал, пауза, продолжил, завершил — откуда и когда.
model WorkdayEvent {
  id       String   @id @default(cuid())
  portalId String
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId   Int
  /// open | pause | resume | close
  action   String   @db.VarChar(10)
  /// Статус после события.
  status   String   @db.VarChar(10)
  source   String   @db.VarChar(10)
  report   String?  @db.VarChar(1000)
  at       DateTime @db.DateTime(3)

  @@index([portalId, userId, at])
}

// ---------- Звонки: исключённые из статистики ----------

/// Звонок, исключённый из статистики дашборда (внутренний тест и т. п.): не считается в показателях,
/// упущенных и списках звонков. Решение администратора приложения — с причиной.
model CallExclusion {
  id         String   @id @default(cuid())
  portalId   String
  portal     Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  /// ID дела CRM звонка (crm.activity, VOXIMPLANT_CALL).
  activityId Int
  reason     String   @db.VarChar(500)
  userId     Int
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@unique([portalId, activityId])
}
