# Скопируйте в .env и заполните. .env не коммитится.

# --- База данных (контейнер db, MariaDB) ---
DB_NAME=btx24
DB_USER=btx24
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
# Порт MariaDB на хосте (слушает только 127.0.0.1).
DB_HOST_PORT=53306
# Пароль read-only пользователя agent_ro (MCP-сервер btx-dev: db_schema, db_query). Пусто — не создаётся.
AGENT_DB_PASSWORD=change-me-too

# --- Приложение (контейнер web — единственный опубликованный) ---
APP_HOST_PORT=3080
APP_HOST_BIND=0.0.0.0
# Публичный HTTPS-адрес приложения (указывается в настройках приложения в Битрикс24).
APP_BASE_URL=

# --- Битрикс24 ---
# Ключ шифрования токенов порталов в БД: openssl rand -base64 32. Смена ключа = переустановка приложения.
ENCRYPTION_KEY=
# Из формы локального приложения на портале (Разработчикам → Другое → Локальное приложение).
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Серверы авторизации, которым доверяем. Для «коробки» добавить домен портала через запятую.
B24_TRUSTED_OAUTH_HOSTS=oauth.bitrix.info,oauth.bitrix24.tech
# Только чтение данных портала (изменяющие REST-методы отклоняются). false — только по решению владельца.
B24_READ_ONLY=true
# Песочница записи при B24_READ_ONLY=true (только по решению владельца): ID сделок через запятую
# и период дат броней [FROM, TO) в поясе портала. Пусто — песочница выключена.
B24_SANDBOX_DEAL_IDS=
B24_SANDBOX_BOOKINGS_FROM=
B24_SANDBOX_BOOKINGS_TO=
# Сервис мессенджеров (ADR 0014): адрес внутри стенда и общий секрет api ↔ messenger
# (openssl rand -hex 24). Пусто — защищает только внутренняя сеть docker.
MESSENGER_URL=http://messenger:3090
MESSENGER_TOKEN=
# HTTP-прокси для мессенджеров (WhatsApp, Telegram): с сервера напрямую недоступны. Пусто в compose —
# прокси по умолчанию из docker-compose.yml.
MESSENGER_PROXY=
