# Скопируйте в .env и заполните. .env не коммитится.

# --- База данных (контейнер db) ---
POSTGRES_DB=btx24
POSTGRES_USER=btx24
POSTGRES_PASSWORD=change-me
# Порт PostgreSQL на хосте (слушает только 127.0.0.1).
DB_HOST_PORT=55432
# Пароль read-only роли agent_ro (MCP-сервер btx-dev: db_schema, db_query). Пусто — роль не создаётся.
AGENT_DB_PASSWORD=change-me-too

# --- Приложение (контейнер app) ---
APP_HOST_PORT=3080
APP_HOST_BIND=0.0.0.0
# Публичный HTTPS-адрес приложения (указывается в настройках приложения в Битрикс24).
APP_BASE_URL=
